# Le site français, Le Fléchoir (ADR 0018) : ce qui le distingue des autres sites au déploiement (ADR 0033).
# Versionné et sans secret ; les secrets restent dans .env (Mac) et .env.production (serveur).
SITE=fr
SITE_LANG=fr
NEXT_PUBLIC_SITE=fr
# Projet Docker Compose sur le serveur : dossier /opt/$PROJET, conteneurs $PROJET-api-1, $PROJET-db-1…
PROJET=leflechoir
DEPLOY_SITE_URL=https://leflechoir.fr
DEPLOY_API_URL=https://api.leflechoir.fr
PAGES_PROJECT=leflechoir
# Le lexique curé de la langue, sur le Mac (make deploy-lexicon)
LEXIQUE_DIR=data/lexicon/build
