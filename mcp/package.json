{
  "name": "flechoir-mcp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Le connecteur MCP de l'API ouverte (ADR 0032) : les assistants IA créent, vérifient et dessinent des grilles de mots fléchés",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.10.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
